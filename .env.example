# Copy to .env and fill in. Never commit the real .env.
OPENAI_API_KEY=
BYLLM_DEFAULT_MODEL=gpt-4o-mini

# GitHub OAuth (integrations/github.jac) - THIS IS THE LOGIN PATH.
# Register an OAuth app at https://github.com/settings/developers with
#   Homepage URL:              http://localhost:8000
#   Authorization callback URL: http://localhost:8000
# then paste the client id/secret here. Scopes requested: "read:user repo".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# FALLBACK ONLY. The login screen sends the browser's own window.location.origin
# as the OAuth redirect_uri, so a deployment that gets a fresh URL on every
# redeploy works without touching this - you only update the callback URL on the
# GitHub OAuth app itself. This value is used when no origin is passed (curl,
# scripts). Must match a callback URL registered on the OAuth app above.
TRIAGE_APP_URL=http://localhost:8000

# Fallback credential: with no OAuth session, every GitHub call (repo listing,
# issue fetch, PR creation) falls back to this Personal Access Token. Handy for
# curl-ing the API without a browser; not needed once OAuth login works.
# Fine-grained PAT, Contents: Read&write + Pull requests: Read&write.
GITHUB_TOKEN=

# Where select_repo clones indexed repos. Disposable, gitignored.
TRIAGE_WORKSPACE=.workspace

# Which model agents/pr_agent.jac uses for the full-file fix rewrite. Left
# unset it stays on the local code model, which is what you want locally.
TRIAGE_FIX_MODEL=

# ---------------------------------------------------------------------------
# HOSTED SHOWCASE BUILD (the jachammer.ai deploy) - leave BOTH unset locally.
# ---------------------------------------------------------------------------
# TRIAGE_SHOWCASE=1 turns on "showcase mode": GitHub login and the live repo
# picker still work, but select_repo / reindex_repo / ingest_* / generate_pr* /
# get_issue_fix_preview refuse immediately and the repo cards render greyed out
# with a tooltip. That's because every by llm() call in Triage targets a LOCAL
# Ollama (jac.toml, agents/pr_agent.jac) and a hosted pod has neither Ollama
# nor an API key. Set it ONLY on the deploy, never in your local .env.
TRIAGE_SHOWCASE=
# Where the "watch the demo instead" link on the showcase banner points.
TRIAGE_DEMO_VIDEO_URL=
