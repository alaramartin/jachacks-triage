# Copy to .env and fill in. Never commit the real .env.
OPENAI_API_KEY=
BYLLM_DEFAULT_MODEL=gpt-4o-mini

# GitHub (Person 2 - integrations/github.jac)
# Real PR creation (generate_pr) uses a Personal Access Token, NOT OAuth -
# OAuth login is a documented scope cut (see PLAN.md). Fine-grained PAT
# scoped to the triage-demo repo, Contents: Read&write + Pull requests: Read&write.
GITHUB_TOKEN=

# OAuth app vars kept for the (currently unused) exchange_code_for_token/list_repos
# scaffolding in integrations/github.jac - not needed for generate_pr.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
